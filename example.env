# Copy to .env and adjust for your environment.

# --- Camunda 8 / Zeebe connection ------------------------------------------
# Local estate (docker-compose-8) exposes gRPC on 26500 and REST on 8088.
ZEEBE_GRPC_ADDRESS=http://localhost:26500
ZEEBE_REST_ADDRESS=http://localhost:8088
# none | oidc | basic. The local self-managed estate uses none.
CAMUNDA_AUTH_METHOD=none
# Only needed when CAMUNDA_AUTH_METHOD=oidc:
# CAMUNDA_CLIENT_ID=orchestration
# CAMUNDA_CLIENT_SECRET=secret
# CAMUNDA_OAUTH_TOKEN_URL=http://localhost:18080/auth/realms/camunda-platform/protocol/openid-connect/token
# CAMUNDA_TOKEN_AUDIENCE=orchestration-api

# --- REST gateway ----------------------------------------------------------
HTTP_PORT=8090

# --- Dashboard read model --------------------------------------------------
# Defaults to embedded H2 when unset. For PostgreSQL:
# DASHBOARD_DB_URL=jdbc:postgresql://localhost:5432/oms
# DASHBOARD_DB_USER=oms
# DASHBOARD_DB_PASSWORD=oms
